# SafeDrive AI MVP - Root Environment Variables (Docker Compose)
# 
# Instructions: Copy this file to `.env` and replace the placeholder values
# with secure, randomly generated strings for local development.
# Do NOT commit your `.env` file to version control.

# Database Credentials
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=distracted_driving_db

# JWT Secret for backend authentication
JWT_SECRET_KEY=generate_a_secure_random_string_and_place_it_here

# Allowed CORS Origins (Frontend URL)
# For local development: http://localhost:3000,http://127.0.0.1:3000
# For production: https://your-frontend-domain.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
